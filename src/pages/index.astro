---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <div class="pb-12 mt-5">
      <h1 class="text-3xl font-medium">Hey there 👋</h1>
      <div class="ml-10 my-10 text-6xl font-bold">I'm <span class="text-angular-blue">Bogdan</span></div>
      <div class="text-3xl py-3 font-semibold">Senior Fullstack Software Developer</div>
      <div class="mt-6">
        <a
          class="inline-block bg-angular-blue hover:bg-blue-800 text-white font-bold px-10 py-5 rounded-2xl shadow transition-colors duration-200"
          href="mailto:hello@brotundu.com"
          target="_blank"
        >
          LET'S CONNECT!
        </a>
      </div>
    </div>
</BaseLayout>
